        </Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/LoodsmanKompasExporter;component/Resources/easteregg.jpg">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                </TransformGroup>
